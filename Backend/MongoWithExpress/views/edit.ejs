<!DOCTYPE html>
<html>
<head>
    <title>Edit Chat</title>
</head>
<body>

    <h2>Edit Chat</h2>

<form action="/chats/<%= chat._id %>" method="POST">
    <input type="text" name="from" value="<%= chat.from %>" required>
    <input type="text" name="to" value="<%= chat.to %>" required>
    <input type="text" name="msg" value="<%= chat.msg %>" required>

    <button>Update</button>
</form>

</body>
</html>