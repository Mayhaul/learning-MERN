<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Qoura posts</h1>
    <a style="text-decoration: none;" href="http://localhost:8080/posts/new">New post</a>
    <% for(post of posts){ %>
        <div class="post">
            <h3 class="user">@<%= post.username %></h3>
            <h4 class="content"><%= post.content%></h4> 
            <br>
            <a style="text-decoration: none;" href="http://localhost:8080/posts/<%= post.id %>">See Post</a>
        </div>
    <%}%>
</body>
</html>